{
  "schemaVersion": 1,
  "catalogId": "archon-context7-capability-pack",
  "title": "Archon Context7 Capability Pack",
  "installPolicy": {
    "scope": ["project", "global"],
    "targets": ["universal", "claude"],
    "modes": ["cli-skills", "mcp-profile"],
    "secretPolicy": "CONTEXT7_API_KEY must come from the environment; no raw key material is stored in repository artifacts."
  },
  "setup": {
    "cliSkill": {
      "name": "find-docs",
      "status": "installed",
      "commands": [
        "npx ctx7 setup --cli --universal --project --yes",
        "npx ctx7 setup --cli --universal --yes"
      ],
      "projectTargets": [".agents/skills/find-docs", ".claude/skills/find-docs"],
      "globalTargets": ["~/.agents/skills/find-docs", "~/.claude/skills/find-docs"]
    },
    "mcp": {
      "status": "profile-configured-auth-blocked",
      "blockedReason": "CONTEXT7_API_KEY was not present in the shell environment when this pack was installed.",
      "profilePath": ".archon/mcp/context7-official.json",
      "requiredCommandWhenKeyExists": "npx ctx7 setup --mcp --codex --project --yes --api-key \"$CONTEXT7_API_KEY\""
    }
  },
  "selectedSkills": [
