{
  "name": "@archon/ui-lab",
  "version": "0.3.10",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p 6006 --ci",
    "storybook": "storybook dev -p 6006",
    "build": "tsc --noEmit && storybook build --output-dir storybook-static",
    "build-storybook": "storybook build --output-dir storybook-static",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --cache --max-warnings 0",
    "test-storybook": "vitest --project=storybook --run",
    "test:e2e": "playwright test",
    "registry:build": "shadcn build --cwd . --output ./public/r"
  },
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./components/ui/*": "./src/components/ui/*.tsx",
    "./components/common/*": "./src/components/common/*.tsx",
    "./components/icons/*": "./src/components/icons/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./templates/*": "./src/templates/*.tsx"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.14.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.75.0",
    "react-resizable-panels": "^4",
    "recharts": "3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.57.0",
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-vitest": "^10.3.6",
    "@storybook/react-vite": "^10.3.6",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/browser-playwright": "^4.1.6",
    "axe-core": "^4.11.4",
    "shadcn": "^3.8.4",
    "storybook": "^10.3.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.3.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.6"
  }
}
