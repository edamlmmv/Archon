{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "archon-ui-core",
  "type": "registry:component",
  "title": "Archon UI Core",
  "description": "Reusable shadcn/Radix primitives extracted from the Archon web UI.",
  "dependencies": [
    "@radix-ui/react-alert-dialog",
    "@radix-ui/react-dialog",
    "class-variance-authority",
    "lucide-react",
    "radix-ui",
    "react-resizable-panels",
    "tailwind-merge"
  ],
  "files": [
    {
      "path": "src/components/ui/alert-dialog.tsx",
      "type": "registry:ui",
      "target": "components/ui/alert-dialog.tsx"
    },
    {
      "path": "src/components/ui/badge.tsx",
      "type": "registry:ui",
      "target": "components/ui/badge.tsx"
    },
    {
      "path": "src/components/ui/button.tsx",
      "type": "registry:ui",
      "target": "components/ui/button.tsx"
    },
    {
      "path": "src/components/ui/card.tsx",
      "type": "registry:ui",
      "target": "components/ui/card.tsx"
    },
    {
      "path": "src/components/ui/collapsible.tsx",
      "type": "registry:ui",
      "target": "components/ui/collapsible.tsx"
    },
    {
      "path": "src/components/ui/dialog.tsx",
      "type": "registry:ui",
      "target": "components/ui/dialog.tsx"
    },
    {
      "path": "src/components/ui/input.tsx",
      "type": "registry:ui",
      "target": "components/ui/input.tsx"
    },
    {
      "path": "src/components/ui/resizable.tsx",
      "type": "registry:ui",
      "target": "components/ui/resizable.tsx"
    },
    {
      "path": "src/components/ui/scroll-area.tsx",
      "type": "registry:ui",
      "target": "components/ui/scroll-area.tsx"
    },
    {
      "path": "src/components/ui/separator.tsx",
      "type": "registry:ui",
      "target": "components/ui/separator.tsx"
    },
    {
      "path": "src/components/ui/tabs.tsx",
      "type": "registry:ui",
      "target": "components/ui/tabs.tsx"
    },
    {
      "path": "src/components/ui/textarea.tsx",
      "type": "registry:ui",
      "target": "components/ui/textarea.tsx"
    },
    {
      "path": "src/components/ui/tooltip.tsx",
      "type": "registry:ui",
      "target": "components/ui/tooltip.tsx"
    },
    { "path": "src/lib/utils.ts", "type": "registry:lib", "target": "lib/utils.ts" },
    { "path": "src/styles.css", "type": "registry:style", "target": "styles.css" }
  ]
}
